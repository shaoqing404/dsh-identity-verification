(version 1)
(allow default)
(deny file-read-data (subpath "/Users") (subpath "/Volumes"))
(allow file-read-data (subpath (param "LAB")))
(deny file-read-data (subpath (string-append (param "LAB") "/m3")))
(deny file-write*)
(allow file-write*
  (subpath (string-append (param "LAB") "/native-rc3/state"))
  (subpath (string-append (param "LAB") "/native-rc3/workspace"))
  (subpath (param "TEMP"))
  (literal "/dev/null"))
(deny process-exec (subpath (string-append (param "LAB") "/m3")))
(deny mach-lookup
  (global-name "com.apple.CoreAuthentication.daemon")
  (global-name "com.apple.CoreAuthentication.daemon.libxpc")
  (global-name "com.apple.CoreAuthentication.daemon.EndpointProvider")
  (global-name "com.apple.CoreAuthentication.agent")
  (global-name "com.apple.coreauthd")
  (global-name "com.apple.biometrickitd")
  (global-name "com.apple.coreservices.launchservicesd"))
(deny network-inbound)
(allow network-inbound (local ip "localhost:38485"))
(deny network-outbound)
